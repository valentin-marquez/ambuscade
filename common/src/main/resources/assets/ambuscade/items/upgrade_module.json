{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "ambuscade:upgrade",
    "cases": [
      {
        "when": "diamond",
        "model": {
          "type": "minecraft:model",
          "model": "ambuscade:item/upgrade_module_diamond"
        }
      },
      {
        "when": "netherite",
        "model": {
          "type": "minecraft:model",
          "model": "ambuscade:item/upgrade_module_netherite"
        }
      },
      {
        "when": "endless",
        "model": {
          "type": "minecraft:model",
          "model": "ambuscade:item/upgrade_module_endless"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "ambuscade:item/upgrade_module_gold"
    }
  }
}
